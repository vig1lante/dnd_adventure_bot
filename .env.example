APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/dnd.sqlite3
SESSION_SECRET=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
GAME_CREATOR_TG_IDS=
WEBAPP_PUBLIC_URL=http://localhost:5173
CONTENT_DIR=content/adventures
# Провайдер мастера: fake (тестовый, по FAKE_LLM_SCENARIO), anthropic_api,
# openai_compatible или claude_code_cli. fake и claude_code_cli — только при APP_ENV=dev:
# в prod с fake сервер не стартует.
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_CHEAP_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
CLAUDE_CLI_PATH=claude
# Модель подписки для claude_code_cli; пусто — значение по умолчанию самого CLI.
# Модель: opus, sonnet, haiku или полное имя; модель игры из формы сильнее этой.
CLAUDE_CLI_MODEL=
# Уровень усилий: low, medium, high, xhigh или max.
CLAUDE_CLI_EFFORT=
# Модель служебных ответов: описание героя, «помоги написать», вплетение,
# летопись, генератор. Идеи у костра и ход мастера идут на модель игры.
CLAUDE_CLI_CHEAP_MODEL=
FAKE_LLM_SCENARIO=
COLLECT_SECONDS=120
HURRY_SECONDS=60
CAMP_SECONDS=300
SHORT_REST_SECONDS=120
