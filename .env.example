# Модель: opus, sonnet, haiku или полное имя; модель игры из формы сильнее этой.
CLAUDE_CLI_MODEL=
# Уровень усилий: low, medium, high, xhigh или max.
CLAUDE_CLI_EFFORT=
# Модель служебных ответов: описание героя, вплетение, летопись,
# идеи для рассказа у костра, генератор.
